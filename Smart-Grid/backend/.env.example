# Copy this file to ".env" and adjust. Real environment variables always win over this file.
# One KEY=value per line, no inline comments.

PORT=4000

# Secret used to sign login tokens. REQUIRED when NODE_ENV=production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# How long a login stays valid, in seconds (default 2 hours)
TOKEN_TTL_SECONDS=7200

# Comma-separated list of browser origins allowed to call the API.
# The default already covers the React dev server (5173), VS Code Live Server (5500),
# the backend itself (4000) and file:// pages ("null"). Remove "null" in production.
# CORS_ORIGINS=http://localhost:5173,http://localhost:5500

# Where customer accounts are stored (JSON file, relative to the backend folder)
# DATA_FILE=data/customers.json

# Serve ../html, ../css and ../javascript at http://localhost:PORT/ (set to false to disable)
# SERVE_FRONTEND=true

# Create the demo account CUSTOMER001 / Demo@123 on startup (default: on, except in production)
# SEED_DEMO_USER=true

# Max login/register attempts per IP per minute
# AUTH_RATE_LIMIT_MAX=20

NODE_ENV=development
